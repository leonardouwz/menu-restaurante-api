{
  "name": "Menu API - Spring Boot",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Menu API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "chmod +x mvnw && ./mvnw -q -DskipTests package",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "humao.rest-client"
      ]
    }
  }
}
